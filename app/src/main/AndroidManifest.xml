<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.porestaurant">

    <!-- Quyền truy cập Internet -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PORestaurant">

        <!-- Launcher Activity -->
        <activity
            android:name=".view.AdminDashboardActivity"
            android:exported="true"
            android:label="Admin Dashboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Nếu bạn không muốn AdminDashboard là launcher,
             chỉ để intent-filter MAIN/LAUNCHER ở MainActivity và
             xoá thẻ <intent-filter> bên dưới. -->
        <activity
            android:name=".view.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PORestaurant">
            <!--
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            -->
        </activity>
        <activity android:name=".view.LoginActivity" />
        <activity android:name=".view.MenuActivity" />
        <activity android:name=".view.ActivityProfile" />
        <activity android:name=".view.RegisterActivity" />
        <activity android:name=".view.BookingActivity" />
        <activity android:name=".view.CreateMenuActivity" />
        <activity android:name=".view.CartActivity" />
        <activity android:name=".view.ForgotPasswordActivity" />
    </application>

</manifest>
