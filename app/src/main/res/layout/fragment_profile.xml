<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FBFD">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="0dp">

        <!-- HEADER xanh với nút Back + Avatar nổi + Tên & Email -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_profile_header"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Nút Back (bạn dùng ic_back là vector asset mũi tên trái) -->
            <ImageView
                android:id="@+id/btnProfileBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:layout_alignParentStart="true"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/circle_white_shadow"
                android:padding="6dp"
                android:elevation="4dp"/>

            <!-- Avatar -->
            <ImageView
                android:id="@+id/imgProfileAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="28dp"
                android:src="@drawable/ic_user"
                android:background="@drawable/circle_white_shadow"
                android:scaleType="centerCrop"
                android:elevation="10dp"/>

            <!-- Full Name -->
            <TextView
                android:id="@+id/tvProfileFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/imgProfileAvatar"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:text="Your Name"
                android:textStyle="bold"
                android:textColor="#fff"
                android:textSize="20sp"/>

            <!-- Email -->
            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvProfileFullName"
                android:layout_centerHorizontal="true"
                android:text="youremail@example.com"
                android:textColor="#E0F7FA"
                android:textSize="14sp"/>
        </RelativeLayout>

        <!-- Card thông tin trắng bo tròn -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_card"
            android:padding="28dp"
            android:layout_marginTop="-40dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="8dp"
            android:gravity="center_horizontal">

            <!-- Full Name -->
            <EditText
                android:id="@+id/edtProfileFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Full Name"
                android:background="@drawable/bg_edittext_rounded_green"
                android:padding="12dp"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"/>

            <!-- EMAIL (readonly) -->
            <TextView
                android:id="@+id/tvProfileEmailReadonly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="youremail@example.com"
                android:textSize="15sp"
                android:textColor="#41C465"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_rounded_light"
                android:paddingLeft="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>

            <!-- PASSWORD -->
            <EditText
                android:id="@+id/edtProfilePassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="New Password"
                android:background="@drawable/bg_edittext_rounded_green"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/edtProfileConfirmPass"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Confirm Password"
                android:background="@drawable/bg_edittext_rounded_green"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_marginBottom="18dp"/>
        </LinearLayout>

        <!-- Button Update -->
        <Button
            android:id="@+id/btnProfileUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Update Profile"
            android:background="@drawable/bg_btn_yellow"
            android:textColor="#fff"
            android:textStyle="bold"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="12dp"/>

        <!-- Button Logout -->
        <Button
            android:id="@+id/btnProfileLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Logout"
            android:background="@drawable/bg_btn_red"
            android:textColor="#fff"
            android:textStyle="bold"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"/>

    </LinearLayout>
</ScrollView> 