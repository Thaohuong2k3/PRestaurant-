<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f9fbfd">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <!-- AVATAR USER -->
        <ImageView
            android:id="@+id/imgProfileAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_user"
            android:background="@drawable/circle_white_shadow"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            android:elevation="8dp"/>

        <!-- FULL NAME -->
        <EditText
            android:id="@+id/edtProfileFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Full Name"
            android:background="@drawable/bg_edittext_rounded"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"/>

        <!-- EMAIL (readonly) -->
        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="16sp"
            android:textColor="#666"
            android:layout_marginBottom="16dp"
            android:paddingLeft="12dp"
            android:background="@drawable/bg_edittext_rounded"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"/>

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/edtProfilePassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="New Password"
            android:background="@drawable/bg_edittext_rounded"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtProfileConfirmPass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Confirm Password"
            android:background="@drawable/bg_edittext_rounded"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnProfileUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Update Profile"
            android:backgroundTint="#ffbe33"
            android:textColor="#fff"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_yellow"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnProfileLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Logout"
            android:backgroundTint="#e57373"
            android:textColor="#fff"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_red"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
